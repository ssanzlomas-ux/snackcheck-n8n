              "id": "f74c5b0a-4097-494b-a6d5-e85703b66a1d",
              "name": "traffic_reading",
              "value": "={{ ['saludable','moderado','no saludable'][Math.min($json.concern_score, 2)] }}",
              "type": "string"
            },
            {
              "id": "83aa850e-75dd-4443-8eb7-cded6e8e0870",
              "name": "nutriscore_reading",
              "value": "={{ ({a:'saludable',b:'saludable',c:'moderado',d:'no saludable',e:'no saludable'})[$json.nutriscore_grade] || 'unknown' }}",
              "type": "string"
            },
            {
              "id": "4b3f0022-afe2-436b-bfc8-e96bbf7b55e7",
              "name": "verdict_level",
              "value": "={{ (() => { const n=['saludable','moderado','no saludable']; const t=Math.min($json.concern_score,2); const ns={a:0,b:0,c:1,d:2,e:2}[$json.nutriscore_grade]; return n[ns === undefined ? t : Math.max(t, ns)]; })() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
