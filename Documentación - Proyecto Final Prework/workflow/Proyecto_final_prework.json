          "assignments": [
            {
              "id": "b554f1bb-b5d6-4d9c-9e41-c27d9a9c8605",
              "name": "message",
              "value": "={{ (() => { const d = $('Set - Determine Verdict Level').item.json; const head = {'saludable':'✅ Buena elección para el día a día','moderado':'🟡 Bien, con moderación','no saludable':'🛑 Mejor como capricho ocasional'}[d.verdict_level]; const m = l => l === 'alto' ? '🔴' : '🟢'; return `${head} ${d.product_name}${d.brands ? ' · ' + d.brands : ''}  ${m(d.sugar_level)} Azúcar   ${d.sugars_100g} g ${m(d.salt_level)} Sal      ${d.salt_100g} g ${m(d.fat_level)} Grasa    ${d.fat_100g} g ⚪ Energía  ${d.energy_kcal_100g ?? '—'} kcal Nutri-Score: ${d.nutriscore_grade.toUpperCase()} · Preocupación: ${d.concern_score}/3  ${$json.text.trim()}`; })() }}",
              "type": "string"
            }
