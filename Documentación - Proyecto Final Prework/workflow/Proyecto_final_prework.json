      "notesInFlow": true,
      "notes": "Semáforo: azúcar >22,5 / 5–22,5 / <5; sal >1,5; grasa >17,5"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Puntuación de preocupación: nº de nutrientes en 'alto' (0-3)\nconst item = $input.item.json;\nconst flags = [item.sugar_level, item.salt_level, item.fat_level];\nitem.concern_score = flags.filter(f => f === 'alto').length;\nreturn { json: item };"
      },
      "type": "n8n-nodes-base.code",
